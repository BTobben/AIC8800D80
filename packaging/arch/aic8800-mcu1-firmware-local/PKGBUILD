pkgname=aic8800-mcu1-firmware-local
pkgver=1
pkgrel=1
pkgdesc='Locally supplied AIC8800D80 MCU1 firmware (not redistributable by this project)'
arch=('any')
url='https://github.com/BTobben/AIC8800D80'
license=('unknown')
provides=('aic8800-mcu1-firmware')
options=('!strip' '!debug')

: "${AIC8800_MCU1_FIRMWARE_DIR:?Set AIC8800_MCU1_FIRMWARE_DIR to a verified prepared directory}"
_firmware_dir=$(realpath -e -- "$AIC8800_MCU1_FIRMWARE_DIR")

source=(
  "file://${_firmware_dir}/fmacfw_8800d80_u02_mcu1.bin"
  "file://${_firmware_dir}/fw_adid_8800d80_u02_mcu1.bin"
  "file://${_firmware_dir}/fw_patch_8800d80_u02_mcu1.bin"
  "file://${_firmware_dir}/fw_patch_table_8800d80_u02_mcu1.bin"
  "file://${_firmware_dir}/lmacfw_rf_8800d80_u02_mcu1.bin"
)
sha256sums=(
  '1ec680c2b63dcaa0e5d33c5fb6d1857d030f8145c05c385e243760388a61a0da'
  'a526cbd02fcdc495f049f3ad6b5933cb08cd984b16790c716a060d582fee1a56'
  '3c5fa5bb678b835adbe42cfe0326074cf8aa5c6d3b93d16d2943b63ad4106b72'
  '58c07eb4c79de6e6beff683686495dec152688f7de59816cfbe71a0c664ca7c8'
  '964a007438c88b2878461311641803b5891ac32483e090694f4bbc263375986d'
)

package() {
  install -d "${pkgdir}/usr/lib/firmware/aic8800D80"
  install -m0644 "${srcdir}"/*_mcu1.bin \
    "${pkgdir}/usr/lib/firmware/aic8800D80/"
}
